// 기획서 permission-system-spec-v1.6.md §5.2 DDL의 Prisma 표현.
// 주의(R-1): 다음 항목은 Prisma가 표현하지 못해 마이그레이션 SQL에 수기로 추가한다 —
//   permissions.scope / resource_grants.effect 의 CHECK 제약,
//   files 의 부분 인덱스(WHERE status='ACTIVE'),
//   audit_logs 파티션 테이블 전체(본 스키마에 모델 없음, WP-6a에서 raw SQL로 접근).
// 이 이중 관리 지점의 목록은 db/migrations/README.md 가 유일한 출처다.

generator client {
  provider = "prisma-client-js"
  // 워크스페이스 공용 패키지(@stonex/db)로 출력 — pnpm 격리 환경에서 앱별로
  // 서로 다른 @prisma/client 인스턴스가 잡혀 미생성 클라이언트를 참조하는 문제 방지
  output   = "../packages/db/generated"
}

datasource db {
  provider = "postgresql"
  // 접속 URL은 Prisma 7 규칙에 따라 prisma.config.ts 에서 주입한다
}

model Tenant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(100)
  status     String   @default("ACTIVE") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz()

  users            User[]
  roles            Role[]
  role_permissions RolePermission[]
  user_roles       UserRole[]
  resource_grants  ResourceGrant[]
  files            File[]
  domains          Domain[]
  file_uploads     FileUpload[]

  domain_verification_attempts DomainVerificationAttempt[]
  domain_transfers             DomainTransfer[]

  @@map("tenants")
}

model User {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                String    @db.Uuid
  email                    String    @db.VarChar(255)
  password_hash            String    @db.VarChar(255)
  name                     String    @db.VarChar(100)
  status                   String    @default("PENDING") @db.VarChar(20)
  perm_version             Int       @default(1)
  must_change_password     Boolean   @default(false)
  totp_enrollment_required Boolean   @default(false)
  totp_secret              String?   @db.VarChar(255)
  failed_login_count       Int       @default(0) // AUTH-2 잠금 (5회/15분) — WP-2 구현 세부
  locked_until             DateTime? @db.Timestamptz()
  created_at               DateTime  @default(now()) @db.Timestamptz()
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz()
  deleted_at               DateTime? @db.Timestamptz()

  tenant         Tenant          @relation(fields: [tenant_id], references: [id])
  user_roles     UserRole[]      @relation("subject")
  roles_granted  UserRole[]      @relation("granter")
  perms_granted  RolePermission[]
  grants_granted ResourceGrant[]
  files          File[]
  domains        Domain[]
  refresh_tokens RefreshToken[]
  verification_tokens VerificationToken[]
  file_uploads        FileUpload[]

  @@unique([tenant_id, email])
  @@map("users")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String   @db.VarChar(255)
  scope       String   @default("global") @db.VarChar(10) // CHECK (global|owned) — 수기 SQL
  module      String   @default("core") @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamptz()

  role_permissions RolePermission[]
  resource_grants  ResourceGrant[]

  @@map("permissions")
}

model Role {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String   @db.Uuid
  code          String   @db.VarChar(50)
  name          String   @db.VarChar(100)
  display_order Int      @default(0) // 정렬·표시 전용. 보안 규칙 사용 금지(INV-2)
  requires_2fa  Boolean  @default(false) // 보유 계정에 2FA 강제 (§10.4)
  is_system     Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz()
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz()

  tenant           Tenant           @relation(fields: [tenant_id], references: [id])
  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@unique([tenant_id, code])
  @@map("roles")
}

model RolePermission {
  tenant_id     String   @db.Uuid
  role_id       String   @db.Uuid
  permission_id String   @db.Uuid
  granted_by    String?  @db.Uuid
  granted_at    DateTime @default(now()) @db.Timestamptz()

  tenant     Tenant     @relation(fields: [tenant_id], references: [id])
  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Restrict)
  granter    User?      @relation(fields: [granted_by], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  tenant_id  String    @db.Uuid
  user_id    String    @db.Uuid
  role_id    String    @db.Uuid
  granted_by String?   @db.Uuid
  granted_at DateTime  @default(now()) @db.Timestamptz()
  expires_at DateTime? @db.Timestamptz()

  tenant  Tenant @relation(fields: [tenant_id], references: [id])
  user    User   @relation("subject", fields: [user_id], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)
  granter User?  @relation("granter", fields: [granted_by], references: [id])

  @@id([user_id, role_id])
  @@index([role_id]) // idx_user_roles_role — 보유자 전원 조회(§8.3 무효화)
  @@map("user_roles")
}

model ResourceGrant {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String    @db.Uuid
  subject_type  String    @default("USER") @db.VarChar(20)
  subject_id    String    @db.Uuid
  resource_type String    @db.VarChar(50)
  resource_id   String    @db.Uuid
  permission_id String    @db.Uuid
  effect        String    @default("ALLOW") @db.VarChar(10) // CHECK (ALLOW|DENY) — 수기 SQL
  conditions    Json?     // 확장 지점: ABAC 조건 (§9.3)
  granted_by    String    @db.Uuid
  granted_at    DateTime  @default(now()) @db.Timestamptz()
  expires_at    DateTime? @db.Timestamptz()

  tenant     Tenant     @relation(fields: [tenant_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  granter    User       @relation(fields: [granted_by], references: [id])

  @@unique([subject_type, subject_id, resource_type, resource_id, permission_id])
  @@index([subject_id, resource_type, resource_id], map: "idx_grants_lookup")
  @@index([resource_type, resource_id], map: "idx_grants_resource")
  @@map("resource_grants")
}

model File {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @db.Uuid
  owner_id    String    @db.Uuid
  name        String    @db.VarChar(255)
  storage_key String    @db.VarChar(512) // 외부 노출 금지(§10.2)
  size_bytes  BigInt
  mime_type   String    @db.VarChar(127)
  checksum    String    @db.VarChar(64)
  status      String    @default("ACTIVE") @db.VarChar(20)
  created_at  DateTime  @default(now()) @db.Timestamptz()
  deleted_at  DateTime? @db.Timestamptz()

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  owner  User   @relation(fields: [owner_id], references: [id])

  @@map("files")
}

model Domain {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String    @db.Uuid
  owner_id     String    @db.Uuid
  /** 항상 정규형(소문자·후행 점 제거·punycode)으로 저장한다 — `fqdn.ts` 참조 */
  fqdn         String    @db.VarChar(253)
  status       String    @default("UNVERIFIED") @db.VarChar(20)
  verify_token String?   @db.VarChar(64)
  verified_at  DateTime? @db.Timestamptz()
  created_at   DateTime  @default(now()) @db.Timestamptz()
  deleted_at   DateTime? @db.Timestamptz()

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  owner  User   @relation(fields: [owner_id], references: [id])

  verification_attempts DomainVerificationAttempt[]
  transfers             DomainTransfer[]

  // (tenant_id, fqdn) 유일성은 **부분 유니크 인덱스**로 강제한다(WP-12 마이그레이션의 수기 SQL).
  // 전체 유니크로 두면 소프트 삭제된 행이 슬롯을 계속 점유해 같은 FQDN 을 영원히 재등록할 수 없다.
  @@map("domains")
}

/**
 * 도메인 소유권 검증 시도 (WP-12, DOM-3).
 *
 * **감사 로그가 아니라 이 테이블에 기록한다** — 검증 실패는 사용자의 DNS 설정 오류가 대부분이라
 * 빈도가 높고, 감사 로그(권한 변경의 법적 기록)에 섞이면 추적 신호가 묻힌다(작업지시서 WP-12-2).
 * 동시에 이 테이블은 **검증 잡 큐를 겸한다** — PENDING 행을 워커가 집어간다.
 */
model DomainVerificationAttempt {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String    @db.Uuid
  domain_id    String    @db.Uuid
  requested_by String    @db.Uuid
  method       String    @default("DNS_TXT") @db.VarChar(20) // §13.2 미결: HTML 방식 병행 시 확장
  state        String    @default("PENDING") @db.VarChar(20) // PENDING | RUNNING | SUCCEEDED | FAILED
  /** 실패 사유 — 사용자에게 그대로 노출되므로 내부 스택은 담지 않는다 */
  reason       String?   @db.VarChar(200)
  created_at   DateTime  @default(now()) @db.Timestamptz()
  finished_at  DateTime? @db.Timestamptz()

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  domain Domain @relation(fields: [domain_id], references: [id])

  @@index([state, created_at]) // 워커 픽업
  @@index([domain_id, created_at]) // 쿨다운·일일 상한 판정
  @@map("domain_verification_attempts")
}

/**
 * 도메인 소유자 이전 발의 (WP-13, DOM-6).
 *
 * **기존 테이블을 건드리지 않고 신규 테이블로 구현한다**(INV-7). 이전은 발의 + 수락의 2단계이며,
 * 동시 발의는 `(domain_id) WHERE status='PENDING'` 부분 유니크로 1건만 허용한다(수기 SQL).
 */
model DomainTransfer {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String    @db.Uuid
  domain_id    String    @db.Uuid
  from_user_id String    @db.Uuid
  to_user_id   String    @db.Uuid
  status       String    @default("PENDING") @db.VarChar(20) // PENDING | ACCEPTED | CANCELLED | EXPIRED | INVALIDATED
  /** 무효 종료 사유 — 수락 시 재검증에서 걸린 항목을 그대로 남긴다 */
  reason       String?   @db.VarChar(200)
  expires_at   DateTime  @db.Timestamptz()
  created_at   DateTime  @default(now()) @db.Timestamptz()
  finished_at  DateTime? @db.Timestamptz()

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  domain Domain @relation(fields: [domain_id], references: [id])

  @@index([to_user_id, status]) // 수령자의 받은 발의 목록
  @@index([from_user_id, status]) // 발의자의 보낸 발의 목록
  @@index([status, expires_at]) // 만료 스윕
  @@map("domain_transfers")
}

// 업로드 세션 (WP-9) — 서명 URL 발급 시점의 조건을 서버가 보관한다.
// 완료 콜백은 불투명 upload_id 만 받으며 storage_key 는 클라이언트에 노출되지 않는다(§10.2).
model FileUpload {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String    @db.Uuid
  requester_id  String    @db.Uuid
  storage_key   String    @db.VarChar(512) // 외부 노출 금지
  expected_mime String    @db.VarChar(127)
  max_bytes     BigInt
  state         String    @default("PENDING") @db.VarChar(20) // PENDING | COMPLETED | EXPIRED | ABORTED
  expires_at    DateTime  @db.Timestamptz()
  completed_at  DateTime? @db.Timestamptz()
  created_at    DateTime  @default(now()) @db.Timestamptz()

  tenant    Tenant @relation(fields: [tenant_id], references: [id])
  requester User   @relation(fields: [requester_id], references: [id])

  @@index([requester_id, state])
  @@index([state, expires_at]) // GC 배치용
  @@map("file_uploads")
}

// 이메일 인증(AUTH-1)·비밀번호 재설정(AUTH-4) 토큰 — 해시만 저장, 1회용
model VerificationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  kind       String    @db.VarChar(20) // EMAIL_VERIFY | PASSWORD_RESET
  token_hash String    @unique @db.VarChar(64) // SHA-256
  expires_at DateTime  @db.Timestamptz()
  used_at    DateTime? @db.Timestamptz()
  created_at DateTime  @default(now()) @db.Timestamptz()

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, kind])
  @@map("verification_tokens")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(64) // SHA-256, 원문 미저장
  family_id  String    @db.Uuid
  expires_at DateTime  @db.Timestamptz()
  revoked_at DateTime? @db.Timestamptz()
  created_at DateTime  @default(now()) @db.Timestamptz()

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([family_id], map: "idx_refresh_family")
  @@index([user_id], map: "idx_refresh_user")
  @@map("refresh_tokens")
}
