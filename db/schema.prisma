// 기획서 permission-system-spec-v1.6.md §5.2 DDL의 Prisma 표현.
// 주의(R-1): 다음 항목은 Prisma가 표현하지 못해 마이그레이션 SQL에 수기로 추가한다 —
//   permissions.scope / resource_grants.effect 의 CHECK 제약,
//   files 의 부분 인덱스(WHERE status='ACTIVE'),
//   audit_logs 파티션 테이블 전체(본 스키마에 모델 없음, WP-6a에서 raw SQL로 접근).
// 이 이중 관리 지점의 목록은 db/migrations/README.md 가 유일한 출처다.

generator client {
  provider = "prisma-client-js"
  // 워크스페이스 공용 패키지(@stonex/db)로 출력 — pnpm 격리 환경에서 앱별로
  // 서로 다른 @prisma/client 인스턴스가 잡혀 미생성 클라이언트를 참조하는 문제 방지
  output   = "../packages/db/generated"
}

datasource db {
  provider = "postgresql"
  // 접속 URL은 Prisma 7 규칙에 따라 prisma.config.ts 에서 주입한다
}

model Tenant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(100)
  status     String   @default("ACTIVE") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz()

  users            User[]
  roles            Role[]
  role_permissions RolePermission[]
  user_roles       UserRole[]
  resource_grants  ResourceGrant[]
  files            File[]
  domains          Domain[]
  file_uploads     FileUpload[]

  domain_verification_attempts DomainVerificationAttempt[]
  domain_transfers             DomainTransfer[]
  governance_freezes           GovernanceFreeze[]
  email_change_requests        EmailChangeRequest[]
  system_settings              SystemSetting[]

  @@map("tenants")
}

model User {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                String    @db.Uuid
  email                    String    @db.VarChar(255)
  password_hash            String    @db.VarChar(255)
  name                     String    @db.VarChar(100)
  status                   String    @default("PENDING") @db.VarChar(20)
  perm_version             Int       @default(1)
  must_change_password     Boolean   @default(false)
  totp_enrollment_required Boolean   @default(false)
  totp_secret              String?   @db.VarChar(255)
  failed_login_count       Int       @default(0) // AUTH-2 잠금 (5회/15분) — WP-2 구현 세부
  locked_until             DateTime? @db.Timestamptz()
  created_at               DateTime  @default(now()) @db.Timestamptz()
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz()
  deleted_at               DateTime? @db.Timestamptz()

  tenant         Tenant          @relation(fields: [tenant_id], references: [id])
  user_roles     UserRole[]      @relation("subject")
  roles_granted  UserRole[]      @relation("granter")
  perms_granted  RolePermission[]
  grants_granted ResourceGrant[]
  files          File[]
  domains        Domain[]
  refresh_tokens RefreshToken[]
  verification_tokens VerificationToken[]
  file_uploads        FileUpload[]
  governance_freezes  GovernanceFreeze[]
  email_change_requests EmailChangeRequest[]

  @@unique([tenant_id, email])
  @@map("users")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String   @db.VarChar(255)
  scope       String   @default("global") @db.VarChar(10) // CHECK (global|owned) — 수기 SQL
  module      String   @default("core") @db.VarChar(50)
  created_at  DateTime @default(now()) @db.Timestamptz()

  role_permissions RolePermission[]
  resource_grants  ResourceGrant[]

  @@map("permissions")
}

model Role {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String   @db.Uuid
  code          String   @db.VarChar(50)
  name          String   @db.VarChar(100)
  display_order Int      @default(0) // 정렬·표시 전용. 보안 규칙 사용 금지(INV-2)
  requires_2fa  Boolean  @default(false) // 보유 계정에 2FA 강제 (§10.4)
  is_system     Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz()
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz()

  tenant           Tenant           @relation(fields: [tenant_id], references: [id])
  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@unique([tenant_id, code])
  @@map("roles")
}

model RolePermission {
  tenant_id     String   @db.Uuid
  role_id       String   @db.Uuid
  permission_id String   @db.Uuid
  granted_by    String?  @db.Uuid
  granted_at    DateTime @default(now()) @db.Timestamptz()

  tenant     Tenant     @relation(fields: [tenant_id], references: [id])
  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Restrict)
  granter    User?      @relation(fields: [granted_by], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model UserRole {
  tenant_id  String    @db.Uuid
  user_id    String    @db.Uuid
  role_id    String    @db.Uuid
  granted_by String?   @db.Uuid
  granted_at DateTime  @default(now()) @db.Timestamptz()
  expires_at DateTime? @db.Timestamptz()

  tenant  Tenant @relation(fields: [tenant_id], references: [id])
  user    User   @relation("subject", fields: [user_id], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)
  granter User?  @relation("granter", fields: [granted_by], references: [id])

  @@id([user_id, role_id])
  @@index([role_id]) // idx_user_roles_role — 보유자 전원 조회(§8.3 무효화)
  @@map("user_roles")
}

model ResourceGrant {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String    @db.Uuid
  subject_type  String    @default("USER") @db.VarChar(20)
  subject_id    String    @db.Uuid
  resource_type String    @db.VarChar(50)
  resource_id   String    @db.Uuid
  permission_id String    @db.Uuid
  effect        String    @default("ALLOW") @db.VarChar(10) // CHECK (ALLOW|DENY) — 수기 SQL
  conditions    Json?     // 확장 지점: ABAC 조건 (§9.3)
  granted_by    String    @db.Uuid
  granted_at    DateTime  @default(now()) @db.Timestamptz()
  expires_at    DateTime? @db.Timestamptz()

  tenant     Tenant     @relation(fields: [tenant_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  granter    User       @relation(fields: [granted_by], references: [id])

  @@unique([subject_type, subject_id, resource_type, resource_id, permission_id])
  @@index([subject_id, resource_type, resource_id], map: "idx_grants_lookup")
  @@index([resource_type, resource_id], map: "idx_grants_resource")
  @@map("resource_grants")
}

model File {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @db.Uuid
  owner_id    String    @db.Uuid
  name        String    @db.VarChar(255)
  storage_key String    @db.VarChar(512) // 외부 노출 금지(§10.2)
  size_bytes  BigInt
  mime_type   String    @db.VarChar(127)
  checksum    String    @db.VarChar(64)
  status      String    @default("ACTIVE") @db.VarChar(20)
  created_at  DateTime  @default(now()) @db.Timestamptz()
  deleted_at  DateTime? @db.Timestamptz()

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  owner  User   @relation(fields: [owner_id], references: [id])

  @@map("files")
}

model Domain {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String    @db.Uuid
  owner_id     String    @db.Uuid
  /** 항상 정규형(소문자·후행 점 제거·punycode)으로 저장한다 — `fqdn.ts` 참조 */
  fqdn         String    @db.VarChar(253)
  status       String    @default("UNVERIFIED") @db.VarChar(20)
  verify_token String?   @db.VarChar(64)
  verified_at  DateTime? @db.Timestamptz()
  created_at   DateTime  @default(now()) @db.Timestamptz()
  deleted_at   DateTime? @db.Timestamptz()

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  owner  User   @relation(fields: [owner_id], references: [id])

  verification_attempts DomainVerificationAttempt[]
  transfers             DomainTransfer[]

  // (tenant_id, fqdn) 유일성은 **부분 유니크 인덱스**로 강제한다(WP-12 마이그레이션의 수기 SQL).
  // 전체 유니크로 두면 소프트 삭제된 행이 슬롯을 계속 점유해 같은 FQDN 을 영원히 재등록할 수 없다.
  @@map("domains")
}

/**
 * 도메인 소유권 검증 시도 (WP-12, DOM-3).
 *
 * **감사 로그가 아니라 이 테이블에 기록한다** — 검증 실패는 사용자의 DNS 설정 오류가 대부분이라
 * 빈도가 높고, 감사 로그(권한 변경의 법적 기록)에 섞이면 추적 신호가 묻힌다(작업지시서 WP-12-2).
 * 동시에 이 테이블은 **검증 잡 큐를 겸한다** — PENDING 행을 워커가 집어간다.
 */
model DomainVerificationAttempt {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String    @db.Uuid
  domain_id    String    @db.Uuid
  requested_by String    @db.Uuid
  method       String    @default("DNS_TXT") @db.VarChar(20) // §13.2 미결: HTML 방식 병행 시 확장
  state        String    @default("PENDING") @db.VarChar(20) // PENDING | RUNNING | SUCCEEDED | FAILED
  /** 실패 사유 — 사용자에게 그대로 노출되므로 내부 스택은 담지 않는다 */
  reason       String?   @db.VarChar(200)
  created_at   DateTime  @default(now()) @db.Timestamptz()
  finished_at  DateTime? @db.Timestamptz()

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  domain Domain @relation(fields: [domain_id], references: [id])

  @@index([state, created_at]) // 워커 픽업
  @@index([domain_id, created_at]) // 쿨다운·일일 상한 판정
  @@map("domain_verification_attempts")
}

/**
 * 도메인 소유자 이전 발의 (WP-13, DOM-6).
 *
 * **기존 테이블을 건드리지 않고 신규 테이블로 구현한다**(INV-7). 이전은 발의 + 수락의 2단계이며,
 * 동시 발의는 `(domain_id) WHERE status='PENDING'` 부분 유니크로 1건만 허용한다(수기 SQL).
 */
model DomainTransfer {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String    @db.Uuid
  domain_id    String    @db.Uuid
  from_user_id String    @db.Uuid
  to_user_id   String    @db.Uuid
  status       String    @default("PENDING") @db.VarChar(20) // PENDING | ACCEPTED | CANCELLED | EXPIRED | INVALIDATED
  /** 무효 종료 사유 — 수락 시 재검증에서 걸린 항목을 그대로 남긴다 */
  reason       String?   @db.VarChar(200)
  expires_at   DateTime  @db.Timestamptz()
  created_at   DateTime  @default(now()) @db.Timestamptz()
  finished_at  DateTime? @db.Timestamptz()

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  domain Domain @relation(fields: [domain_id], references: [id])

  @@index([to_user_id, status]) // 수령자의 받은 발의 목록
  @@index([from_user_id, status]) // 발의자의 보낸 발의 목록
  @@index([status, expires_at]) // 만료 스윕
  @@map("domain_transfers")
}

// 업로드 세션 (WP-9) — 서명 URL 발급 시점의 조건을 서버가 보관한다.
// 완료 콜백은 불투명 upload_id 만 받으며 storage_key 는 클라이언트에 노출되지 않는다(§10.2).
model FileUpload {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String    @db.Uuid
  requester_id  String    @db.Uuid
  storage_key   String    @db.VarChar(512) // 외부 노출 금지
  expected_mime String    @db.VarChar(127)
  max_bytes     BigInt
  state         String    @default("PENDING") @db.VarChar(20) // PENDING | COMPLETED | EXPIRED | ABORTED
  expires_at    DateTime  @db.Timestamptz()
  completed_at  DateTime? @db.Timestamptz()
  created_at    DateTime  @default(now()) @db.Timestamptz()

  tenant    Tenant @relation(fields: [tenant_id], references: [id])
  requester User   @relation(fields: [requester_id], references: [id])

  @@index([requester_id, state])
  @@index([state, expires_at]) // GC 배치용
  @@map("file_uploads")
}

/**
 * L-2 권한 변경 동결 (WP-14b, 기획서 §14.4).
 *
 * 이상 정황이 잡힌 계정의 **권한 변경 기능만** 묶는다 — 서비스 이용 자체는 유지한다.
 * 계정 정지(users.status)와는 다른 축이며, 기존 테이블을 건드리지 않는다(INV-7).
 *
 * 해제는 **피동결자 본인을 제외한** 활성 SUPER_ADMIN 1인이 승인한다. 0명이면 break-glass 로 넘어간다.
 */
model GovernanceFreeze {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String    @db.Uuid
  user_id      String    @db.Uuid
  /** 발동 근거 — RI 번호 또는 이상 탐지 규칙 ID */
  trigger      String    @db.VarChar(50)
  reason       String    @db.VarChar(300)
  status       String    @default("ACTIVE") @db.VarChar(20) // ACTIVE | RELEASED
  frozen_at    DateTime  @default(now()) @db.Timestamptz()
  released_at  DateTime? @db.Timestamptz()
  /** 해제 승인자 — 피동결자 본인일 수 없다(서비스가 강제) */
  released_by  String?   @db.Uuid
  release_note String?   @db.VarChar(300)

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])

  @@index([user_id, status]) // 권한 변경 진입부의 선행 검사
  @@index([tenant_id, status])
  @@map("governance_freezes")
}

/**
 * 이메일(로그인 식별자) 변경 요청 (MEM-1, 기획서 §6.2).
 *
 * **바꾸려는 주소를 별도 테이블에 둔다**(INV-7 — 기존 테이블 무변경). `verification_tokens` 에
 * 컬럼을 더하지 않는 이유는, 그 테이블이 가입·비밀번호 재설정과 공유되는 범용 구조라
 * "이 요청에만 있는 필드"가 섞이면 나머지 용도에서 항상 NULL 인 컬럼이 되기 때문이다.
 *
 * **확인 전까지 users.email 은 그대로다.** 즉시 바꾸면 오타 하나로 계정에 들어갈 수 없게 되고,
 * 세션을 탈취한 공격자가 주소만 바꿔 두어도 비밀번호 재설정 메일이 공격자에게 간다.
 */
model EmailChangeRequest {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String    @db.Uuid
  user_id    String    @db.Uuid
  /** 바꾸려는 새 주소. 확인이 끝나야 users.email 로 옮겨간다 */
  new_email  String    @db.VarChar(255)
  /** 새 주소로 보낸 확인 토큰의 SHA-256. 원문은 저장하지 않는다 */
  token_hash String    @unique @db.VarChar(64)
  status     String    @default("PENDING") @db.VarChar(20) // PENDING | CONFIRMED | CANCELLED | EXPIRED
  expires_at DateTime  @db.Timestamptz()
  created_at DateTime  @default(now()) @db.Timestamptz()
  confirmed_at DateTime? @db.Timestamptz()

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([status, expires_at])
  @@map("email_change_requests")
}

/**
 * 시스템 설정 (범용 배포 지원).
 *
 * **이 프로젝트는 내려받은 사람이 자기 환경에 맞춰 쓰는 것을 전제한다.** 접속 정보를
 * 환경 변수로만 받으면 설정을 바꿀 때마다 배포 파일을 고치고 재기동해야 하는데, 그건
 * 코드를 다룰 줄 아는 사람에게만 열린 문이다. 그래서 운영 설정은 관리 화면에서 주입한다.
 *
 * 다만 **부트스트랩 3종은 여전히 환경 변수**다(DATABASE_URL·SETTINGS_ENCRYPTION_KEY·JWT_SECRET).
 * DB 주소를 DB에 둘 수 없고, 비밀값을 푸는 열쇠를 같은 DB에 두면 자물쇠 옆에 열쇠를 두는 셈이다.
 *
 * 비밀값은 `secret_value` 에 AES-256-GCM 으로 암호화해 담고 **응답으로 절대 되돌려주지 않는다**.
 */
model SystemSetting {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String   @db.Uuid
  /** 'mail' | 'storage' — 화면의 묶음 단위이자 연결 테스트의 단위 */
  category     String   @db.VarChar(50)
  key          String   @db.VarChar(100)
  /** 평문 값 (호스트·포트·버킷 등). 비밀 항목이면 NULL */
  value        String?  @db.VarChar(500)
  /** 암호문 (iv.tag.ciphertext, base64). 평문 항목이면 NULL */
  secret_value String?  @db.Text
  is_secret    Boolean  @default(false)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz()
  updated_by   String?  @db.Uuid

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, category, key])
  @@index([tenant_id, category])
  @@map("system_settings")
}

// 소유자 정리 퍼지 큐 (Phase 3 WP-K2, DEC-3 즉시 차단).
// 회원 삭제 트랜잭션은 이 행 1건만 넣는다(O(1)) — 은닉은 users.deleted_at 표식이 즉시
// 담당하고, 리소스의 실제 소프트삭제·Grant 정리는 워커가 배치로 이어받는다(RT-27).
model OwnerCleanupJob {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String    @db.Uuid
  user_id    String    @db.Uuid
  // PENDING → (배치 반복) → DONE / FAILED(재시도 소진 — 순찰 검출 대상)
  status     String    @default("PENDING") @db.VarChar(20)
  attempts   Int       @default(0)
  last_error String?
  // 시간은 **DB 가 채운다**(dbgenerated). Prisma 클라이언트가 넣는 Date 는 어댑터의
  // 시간대 문제로 9시간 어긋나게 저장됨을 실측 확인(생성 직후 age=540분) — RI-10 의
  // "30분 정체" 판정이 전부 오탐이 된다. 갱신도 워커가 raw SQL 의 now() 로 한다.
  created_at DateTime  @default(dbgenerated("now()")) @db.Timestamptz()
  updated_at DateTime  @default(dbgenerated("now()")) @db.Timestamptz()

  @@index([status, updated_at])
  @@map("owner_cleanup_jobs")
}


// ═══ board 모듈 기여 시작 (D-2 — 트랙 B 추출 시 이 블록이 모듈 스키마 조각이 된다) ═══
//
// 커널 모델(Tenant·User)에 역참조를 추가하지 않는다(OQ-2 권고) — Prisma 관계는 양방향
// 선언을 요구해 커널 스키마 수정이 되므로, FK 는 마이그레이션 수기 SQL 로 건다.
// CHECK·부분 인덱스·search_tsv(GENERATED)·updated_at 트리거도 수기 SQL(README 참조).
// 시간 컬럼은 전부 DB now() — 클라이언트 Date 는 시간대가 어긋난다(OwnerCleanupJob 참조).

model Board {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String    @db.Uuid
  slug       String    @db.VarChar(64)
  name       String    @db.VarChar(120)
  board_type String    @default("FORUM") @db.VarChar(32)
  visibility String    @default("PUBLIC") @db.VarChar(16) // PUBLIC|RESTRICTED|PRIVATE — CHECK 수기
  settings   Json      @default("{}")
  status     String    @default("ACTIVE") @db.VarChar(16) // ACTIVE|ARCHIVED|DELETED — CHECK 수기
  post_count BigInt    @default(0)
  created_by String    @db.Uuid // 생성 관리자 — **소유자가 아니다**(§3.3, 서술자 owner 없음)
  created_at DateTime  @default(dbgenerated("now()")) @db.Timestamptz()
  updated_at DateTime  @default(dbgenerated("now()")) @db.Timestamptz()
  deleted_at DateTime? @db.Timestamptz()

  @@unique([tenant_id, slug])
  @@map("boards")
}

model BoardMember {
  board_id   String   @db.Uuid
  user_id    String   @db.Uuid
  board_role String   @default("MEMBER") @db.VarChar(16) // 표시·기본값 전용 — 인가 판정 금지(BINV-1)
  joined_at  DateTime @default(dbgenerated("now()")) @db.Timestamptz()

  @@id([board_id, user_id])
  @@index([user_id])
  @@map("board_members")
}

model BoardCapability {
  board_id       String  @db.Uuid
  capability_key String  @db.VarChar(48)
  enabled        Boolean @default(true)
  config         Json    @default("{}")

  @@id([board_id, capability_key])
  @@map("board_capabilities")
}

model Post {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String    @db.Uuid
  board_id      String    @db.Uuid
  owner_id      String    @db.Uuid
  title         String    @db.VarChar(300)
  body_md       String // 원본 마크다운(정본)
  body_html     String // 서버 렌더·새니타이즈 캐시 — 표시는 이 컬럼만(§7)
  status        String    @default("PUBLISHED") @db.VarChar(16) // DRAFT|PUBLISHED|HIDDEN|DELETED
  is_pinned     Boolean   @default(false)
  comment_count BigInt    @default(0)
  created_at    DateTime  @default(dbgenerated("now()")) @db.Timestamptz()
  updated_at    DateTime  @default(dbgenerated("now()")) @db.Timestamptz()
  deleted_at    DateTime? @db.Timestamptz()
  // search_tsv tsvector GENERATED — 수기 SQL (§8, Prisma 미표현)

  @@index([board_id, created_at(sort: Desc), id(sort: Desc)], map: "idx_posts_board_created_all")
  @@map("posts")
}

model Comment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String    @db.Uuid
  post_id    String    @db.Uuid
  owner_id   String    @db.Uuid
  parent_id  String?   @db.Uuid
  path       String // materialized path: '0001.0007.0003' (§9)
  depth      Int       @default(0) @db.SmallInt
  body_md    String
  body_html  String
  status     String    @default("PUBLISHED") @db.VarChar(16) // PUBLISHED|HIDDEN|DELETED
  created_at DateTime  @default(dbgenerated("now()")) @db.Timestamptz()
  updated_at DateTime  @default(dbgenerated("now()")) @db.Timestamptz()
  deleted_at DateTime? @db.Timestamptz()

  @@index([post_id, path])
  @@map("comments")
}

model PostAttachment {
  post_id    String @db.Uuid
  file_id    String @db.Uuid
  sort_order Int    @default(0) @db.SmallInt

  @@id([post_id, file_id])
  @@map("post_attachments")
}

// ── board 모듈 기여: WP-B3 상호작용 (D-2) ──

// 이벤트 버스 outbox (스펙 §6.2 비동기 레인) — 도메인 트랜잭션과 함께 커밋되고
// 워커가 at-least-once 로 전달한다. 중복 억제는 소비자 측 멱등(source_event_id 유니크).
model BoardOutboxEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String    @db.Uuid
  topic        String    @db.VarChar(48) // comment.created | reaction.added | …
  payload      Json
  attempts     Int       @default(0)
  last_error   String?
  created_at   DateTime  @default(dbgenerated("now()")) @db.Timestamptz()
  processed_at DateTime? @db.Timestamptz()

  @@index([processed_at, created_at])
  @@map("board_outbox_events")
}

// 알림 (기반 기능모듈 — 스펙 §6.4, RT-32). 내용은 링크·최소 메타만(§6.5 mention 규칙) —
// 열람 시점에 접근을 재판정하므로 알림 자체가 유출 경로가 되지 않는다.
model BoardNotification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String    @db.Uuid
  user_id         String    @db.Uuid
  kind            String    @db.VarChar(48)
  payload         Json
  source_event_id String    @db.Uuid
  created_at      DateTime  @default(dbgenerated("now()")) @db.Timestamptz()
  read_at         DateTime? @db.Timestamptz()

  // at-least-once 전달의 중복 억제 — 같은 이벤트가 같은 사람에게 두 번 오지 않는다(R-B14)
  @@unique([user_id, source_event_id])
  @@index([user_id, read_at, created_at])
  @@map("board_notifications")
}

// 반응 (기능모듈 reaction — §6.4). 토글 멱등: 같은 (글, 사람, 종류)는 한 번만
model BoardReaction {
  post_id    String   @db.Uuid
  user_id    String   @db.Uuid
  kind       String   @db.VarChar(24)
  created_at DateTime @default(dbgenerated("now()")) @db.Timestamptz()

  @@id([post_id, user_id, kind])
  @@map("board_reactions")
}

// 태그 (기능모듈 tag — §6.4)
model BoardTag {
  post_id String @db.Uuid
  tag     String @db.VarChar(48)

  @@id([post_id, tag])
  @@index([tag])
  @@map("board_tags")
}

// ═══ board 모듈 기여 끝 ═══

// 이메일 인증(AUTH-1)·비밀번호 재설정(AUTH-4) 토큰 — 해시만 저장, 1회용
model VerificationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  kind       String    @db.VarChar(20) // EMAIL_VERIFY | PASSWORD_RESET
  token_hash String    @unique @db.VarChar(64) // SHA-256
  expires_at DateTime  @db.Timestamptz()
  used_at    DateTime? @db.Timestamptz()
  created_at DateTime  @default(now()) @db.Timestamptz()

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, kind])
  @@map("verification_tokens")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(64) // SHA-256, 원문 미저장
  family_id  String    @db.Uuid
  expires_at DateTime  @db.Timestamptz()
  revoked_at DateTime? @db.Timestamptz()
  created_at DateTime  @default(now()) @db.Timestamptz()

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([family_id], map: "idx_refresh_family")
  @@index([user_id], map: "idx_refresh_user")
  @@map("refresh_tokens")
}
