# 로컬 개발용 예시 — 복사하여 .env 로 사용 (.env 는 git 미추적)
DATABASE_URL=postgresql://USER@localhost:5432/stonex_dev

# 최초 SUPER_ADMIN 시드 (기획서 §13.1 — 하드코딩 금지, 환경 변수로만)
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-on-first-login

# JWT 서명 키 (32자 이상 필수 — 미설정 시 서버 기동 실패)
JWT_SECRET=change-me-to-a-random-32char-plus-secret

# 권한 스냅샷 캐시 (미설정 시 DB 폴백으로 동작)
REDIS_URL=redis://localhost:6379

# 오브젝트 스토리지 (개발: MinIO / 운영: AWS S3 — endpoint 미지정 시 S3)
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=stonex
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_REGION=us-east-1

# 브라우저에서 API 를 호출할 출처. 콤마로 여러 개. 와일드카드는 쓰지 않는다.
CORS_ORIGINS=http://localhost:3002

# 개발 전용: 메일 본문(토큰 원문)을 서버 로그에 남긴다. 운영에서는 절대 켜지 말 것.
DEV_MAIL_LOG_BODY=0
